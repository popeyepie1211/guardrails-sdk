# PostgreSQL / TimescaleDB
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres

# Required by dbapi.py registration and ingestion-server.js.
# Generate a strong, deployment-specific secret; never commit its real value.
API_KEY_PEPPER=

# Evaluation harness keys belong only in a local ignored .env.
MODEL_API_KEY_ADULT_INCOME_MODEL_V1=
MODEL_API_KEY_HOUSE_PRICE_MODEL_V1=
MODEL_API_KEY_CREDIT_FRAUD_MODEL_V1=
