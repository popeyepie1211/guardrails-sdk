{
  "name": "guardrails-sdk",
  "version": "1.0.0",
  "description": "Client SDK for Guardrails hosted vitals ingestion and explainability.",
  "author": "Guardrails Team",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/popeyepie1211/guardrails-sdk.git"
  },
  "homepage": "https://guardrail.ai",
  "bugs": {
    "url": "https://github.com/popeyepie1211/guardrails-sdk/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "start:ingestion": "node ingestion-server.js",
    "dev:ingestion": "nodemon ingestion-server.js",
    "test:mock": "node test/mock-model.js",
    "test": "node test/mock-model.js",
    "build": "esbuild src/index.js --bundle --format=esm --outfile=dist/index.mjs --sourcemap && esbuild src/index.js --bundle --platform=node --format=cjs --outfile=dist/index.cjs --sourcemap",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ml-monitoring",
    "explainability",
    "shap",
    "model-vitals",
    "governance"
  ],
  "dependencies": {
    "axios": "^1.13.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "ioredis": "^5.10.0",
    "nanoid": "^5.1.6",
    "nodemon": "^3.0.1",
    "redis": "^5.11.0",
    "uuid": "^9.0.0"
  },
  "files": [
    "dist/",
    "README.md"
  ]
}
